  /* ----------------------------------------------------------------
     Economy  —  in-game currency (full database settings in economy.json)
  ---------------------------------------------------------------- */
  "economy": {
    // Currency symbol and starting balance are configured in economy.json, not here —
    // these keys used to also exist here but were always shadowed by economy.json's copy.
    // Multiplier for all /sell prices  (1.0 = 100%, 0.5 = 50%, 2.0 = 200%)
    "sellMultiplier": 1.0,
    // Allow selling items that have a custom display name (renamed items)
    "allowSellNamedItems": false,
    // Use a detected external economy mod (e.g. SG Economy API) instead of NeoEssentials'
    // own internal balances, registered at higher priority into the Vault service registry
    // (see vault/VaultManager.java). Off by default — an operator has to explicitly opt in,
    // since silently switching which mod controls player money is higher-stakes than the
    // equivalent external-permissions toggle.
    "useExternalEconomy": false
  },

  /* ----------------------------------------------------------------
     Localization  —  server language and translation-file handling
  ---------------------------------------------------------------- */
  "localization": {
    // Language code (e.g. "fr_fr", "de_de"). Leave empty for "en_us". Change with /language <code>.
    "language": "",

    /* If true, the mod will never modify the on-disk language file after first
     * creation — not even to add newly translated keys or auto-fix legacy
     * {NAME}/{HOME} placeholders left over from older versions.
     * Keys missing from your file will show a readable placeholder derived from
     * the key name instead of the real translation.
     * Leave false unless you are hand-maintaining a fully custom translation file.
     */
    "preserveCustomTranslations": false
  },

  /* ----------------------------------------------------------------
     Web Dashboard  —  built-in HTTP management interface
     Access at  http://YOUR_SERVER_IP:8080  (default port)
  ---------------------------------------------------------------- */
  "webDashboard": {
    // Master switch for the web dashboard
    "enabled": true,
    // Start automatically on server boot. false = use /dashboard start
    "autoStart": false,
    // HTTP server port (1024–65535). Restart required after changing.
    "port": 8080,
    // WebSocket port for real-time updates. Must differ from HTTP port.
    "websocketPort": 8081,
    // Bind address: '0.0.0.0' = all interfaces, '127.0.0.1' = localhost only (more secure)
    "bindAddress": "0.0.0.0",
    // How the dashboard is served:
    //  "external" — serve ONLY the REST API under "/api/*"; the "/" static-file
    //               route is not registered at all (default). Use this if you run
    //               a separate dashboard app (e.g. NeoEssentials-Dashboard, a
    //               Laravel app) that talks to this API from outside.
    //  "internal" — serve the mod's own bundled dashboard UI (webdashboard-ui) at "/"
    //               AND the REST API under "/api/*".
    //  "both"     — serve both (same as "internal", kept as an explicit alias for
    //               clarity when you intentionally use the built-in UI AND point an
    //               external app at the same API).
    "mode": "external",

    // Public-facing base URL for the mod's OWN bundled dashboard (mode "internal"/"both"),
    // e.g. "http://your.server.ip:8080" or "https://mc.example.com" if reverse-proxied.
    // The mod cannot reliably auto-detect this — it may sit behind NAT/port-forwarding or a
    // proxy, so bindAddress/port alone aren't enough to build a browser-usable link. Leave
    // empty to disable features that need a public dashboard link (e.g. the in-chat
    // "view profile" link on player names) when running in "internal" mode. Not needed at
    // all in "external" mode — externalDashboard.url below is used instead.
    "publicUrl": "",

    // Point the in-chat "view profile" link at your OWN external site instead of either
    // NeoEssentials dashboard — full control over the URL shape. Supports {player} (URL-encoded
    // username) and {uuid} placeholders, e.g. "https://myserver.com/players/{player}". Takes
    // priority over externalDashboard.url/publicUrl above when set. Leave empty to use one of
    // those instead.
    "customProfileUrlTemplate": "",

    // Populated automatically by running `/dashboard pair <dashboardUrl> <code>` in-game/
    // console (get the code from the dashboard's own Configuration page) — never hand-type
    // these. Once paired, url/token push a notification (Authorization: Bearer <token>)
    // whenever a dashboard_user is created/updated/deleted here, so the external dashboard
    // can mirror the change into its own user table automatically. Empty/absent = not
    // paired yet. Use /dashboard unpair to clear. This URL is also reused to build the
    // in-chat "view profile" link on player names when running in "external" mode.
    "externalDashboard": {
      "url": "",
      "token": "",
      "keyId": ""
    },

    // Keeps a linked player's dashboard role (see /dashboardregister) in sync with their real
    // in-game permission status — grants ADMIN when they gain the configured permission/group,
    // revokes it again when they lose it. Off by default. Only ever adjusts roles it granted
    // itself — a role you set manually (e.g. /apikey create <label> OPERATOR) is never touched.
    "roleSync": {
      "enabled": false,
      // How often (seconds) the reconciliation sweep runs, in addition to an immediate check
      // whenever a linked player joins.
      "intervalSeconds": 300,
      // A player with this permission node is granted the dashboard ADMIN role. Leave empty to
      // not check by permission node.
      "adminPermission": "neoessentials.admin.dashboard",
      // A player in this permission group is granted the dashboard ADMIN role. Leave empty to
      // not check by group. Checked in addition to (OR) adminPermission.
      "adminGroup": "admin"
    },

    "securitySettings": {
      // Require Bearer token authentication on all API endpoints (strongly recommended)
      "requireAuthentication": true,
      // Enable per-IP rate limiting on dashboard API requests
      "enableRateLimiting": true,
      // Maximum API requests per IP per minute when rate limiting is enabled
      "maxRequestsPerMinute": 60,
      // Public, no-login player moderation lookup (bans/mutes/kicks/warns by player name,
      // plus a recent-punishments feed) — matches ban-management plugins' public transparency
      // page. Never exposes IP bans/IP mutes regardless of this setting.
      "publicModerationLookupEnabled": true
    }
  },

  /* ----------------------------------------------------------------
     Security  —  input validation and command safety
  ---------------------------------------------------------------- */
  "security": {
    "enableInputValidation": true,
    "maxCommandLength": 256,
    "maxReasonLength": 500,
    "allowUnsafeCommands": true,
    // Controls whether the CommandLengthEnforcer event handler validates player commands
    "enableCommandLengthEnforcer": true
  },

  /* ----------------------------------------------------------------
     Items  —  item spawning, enchantments, and stack sizes
  ---------------------------------------------------------------- */
  "items": {
    // Require 'neoessentials.item.spawn' (and per-item nodes) to spawn items via commands
    "permission-based-item-spawn": false,
    // Maximum stack size for oversized stacks
    "oversized-stacksize": 64,
    // Default stack size for all items. -1 = use vanilla behaviour.
    "default-stack-size": -1,
    // Allow enchantments beyond vanilla limits (e.g. Sharpness X)
    "unsafe-enchantments": true,
    // Maximum level allowed when unsafe-enchantments is true
    "max-unsafe-enchantment-level": 32767,
    // Items that cannot be spawned via commands even with permissions
    "item-spawn-blacklist": [
      "minecraft:bedrock",
      "minecraft:barrier",
      "minecraft:command_block",
      "minecraft:chain_command_block",
      "minecraft:repeating_command_block",
      "minecraft:structure_block",
      "minecraft:jigsaw",
      "minecraft:debug_stick",
      "minecraft:knowledge_book"
    ],
    // Log every /invsee and /enderchest view/edit to neoessentials/inventory_audit.log
    "inventoryAuditLog": true
  },

  /* ----------------------------------------------------------------
     Shop  —  dynamic pricing for ChestShop / NPC shops (off by default;
     shops otherwise just use their fixed configured buy/sell price)
  ---------------------------------------------------------------- */
  "shop": {
    "pricing": {
      // Master switch. false = every shop uses its raw configured buy/sell price, no
      // computation overhead at all. All the sub-sections below are ignored while off.
      "enabled": false,

      // Prices drift toward maxMultiplier as a shop's stock depletes, and toward
      // minMultiplier as it fills back up — buying gets more expensive, selling gets
      // less rewarding, the closer a shop is to running out.
      "supplyDemand": {
        "enabled": true,
        // Stock level (items) at which the multiplier bottoms out at minMultiplier
        "maxStock": 500,
        "minMultiplier": 0.8,
        "maxMultiplier": 2.0
      },

      // Flat percentage discount on buy prices during a fixed daily time window
      // (server time, 24h clock).
      "timeDiscount": {
        "enabled": true,
        "startHour": 12,
        "endHour": 14,
        "discountPercent": 10.0
      },

      // Extra discount for buying in bulk. Each tier's discount applies once the
      // purchase quantity reaches minQuantity; only the highest tier a purchase
      // qualifies for is applied. Leave the array empty to disable bulk discounts
      // without touching the other rules above.
      "bulkTiers": [
        { "minQuantity": 16, "discountPercent": 5.0 },
        { "minQuantity": 64, "discountPercent": 10.0 }
      ]
    }
  },

  /* ----------------------------------------------------------------
     Permissions  —  group-based permission system
     Group definitions live in permissions.json.
  ---------------------------------------------------------------- */
  "permissions": {
    // Use an external permission system (LuckPerms etc.) instead of the built-in one
    "useExternalPermissions": true,
    "defaultGroup": "default",
    // Allow server operators (OP level) to bypass permission checks
    "opsBypassPermissions": true,
    "vanillaOpFallback": true,
    // Whether the two OP-bypass settings above also apply to GRADED economy-modifier
    // permission nodes (neoessentials.economy.sellmultiplier.*, .taxexempt, .nopaycooldown,
    // .maxbalance.*, .paylimit.*). Those nodes represent opt-in bonuses meant to be granted
    // explicitly (per-player or per-group) — not admin capabilities — so this defaults to
    // false: OPs get their usual command-permission bypass, but do NOT silently receive the
    // highest sell multiplier / free tax exemption / no pay cooldown just for being OP.
    // Set true to restore the old blanket-bypass behavior.
    "opsBypassEconomyModifierPermissions": false,
    // Whether a wildcard permission (e.g. "neoessentials.*", "neoessentials.economy.*")
    // granted to a group or user is allowed to satisfy the same graded economy-modifier nodes
    // above (sellmultiplier tiers, taxexempt, nopaycooldown, maxbalance/paylimit tiers).
    // Defaults to false: those nodes must be listed explicitly (either the exact node itself,
    // or a wildcard scoped no broader than "neoessentials.economy.sellmultiplier.*" etc.) even
    // for a group whose permission list is just "neoessentials.*" — a broad admin wildcard
    // should not silently hand out a 3x sell multiplier or free tax exemption nobody
    // deliberately assigned that group. Set true to let wildcards cover these nodes too.
    "wildcardsGrantEconomyModifierPermissions": false,
    "cachePermissions": true,
    // Minutes before cached permission entries expire
    "permissionCacheExpiryMinutes": 30,
    // Log all permission grant/revoke actions
    "auditLogging": true
  },

  /* ----------------------------------------------------------------
     AFK System
  ---------------------------------------------------------------- */
  "afk": {
    "enabled": true,
    // Seconds of inactivity before a player is marked AFK
    "timeout": 300,
    // Seconds after going AFK before the player is kicked (0 = disabled)
    "kickTimeout": 0,
    "afkkickMessage": "Kicked for being AFK too long",
    "enableafkBroadcasts": true,
    "broadcastOnAfk": true,
    "broadcastOnReturn": true,
    "afkMessage": "{player} is now AFK",
    "returnMessage": "{player} is no longer AFK",
    // AFK indicator in the tablist is configured in tablist.json (showAfkIndicator/afkSuffix),
    // not here.
    // Ignore AFK players when counting sleep votes
    "ignoreAfkInSleep": true,
    "enableActivityTracking": true,
    "trackMovement": true,
    "trackChat": true,
    "trackCommands": true,
    "trackInteractions": true,
    "movementThreshold": 0.1,
    "rotationThreshold": 5.0,
    // Commands that do not reset the AFK timer
    "excludedCommands": ["afk", "list", "who", "tps", "ping", "help", "?"],
    "autoSave": true,
    "saveInterval": 60,
    // Make AFK players immune to all damage (mobs, environment, explosions, etc.)
    // Useful for hardcore-style servers where an AFK death would be permanent
    "invulnerableWhenAfk": false
  },

  /* ----------------------------------------------------------------
     Kits  —  kit system settings  (kit contents in kits.json)
  ---------------------------------------------------------------- */
  "kits": {
    // Hide one-time-use kits from /kit list after they have been claimed
    "skipUsedOneTimeKitsFromKitList": false,
    // Auto-equip kit armor when the player's armor slots are empty
    "kitAutoEquip": false,
    // Use pastebin for /createkit output instead of writing to kits.json directly
    "pastebinCreatekit": false,
    // Maximum active kit cooldowns per player (-1 = unlimited)
    "maxKitsPerPlayer": 10,
    // Allow players with the override permission to bypass kit cooldowns
    "allowKitOverride": true,
    // Log kit usage to server logs
    "logKitUsage": true,

    // Economy cost per kit command use (0 = free)
    "commandCosts": {
      "kit": 0,
      "createkit": 0,
      "delkit": 0,
      "listkits": 0
    },

    // Kit given to players on their very first join (bypasses cost and permissions)
    "newPlayerKit": {
      "enabled": false,
      // Kit name, e.g. "starter". Leave empty to disable.
      "kitName": ""
    }
  },

  /* ----------------------------------------------------------------
     Teleportation  —  homes, warps, spawn, TPA, /back, /tpr
  ---------------------------------------------------------------- */
  "teleportation": {

    "homeSettings": {
      // Maximum homes per player (-1 = unlimited)
      "maxHomes": 5,
      // Allow homes to be set in the Nether, End, etc.
      "allowCrossDimensionHomes": true,
      // Cooldown in seconds between /sethome uses (0 = disabled)
      "homeSetCooldown": 30,
      // Cooldown in seconds between /home teleports (0 = disabled)
      "homeTeleportCooldown": 5,
      // Cooldown in seconds between /delhome uses (0 = disabled)
      "homeDeleteCooldown": 10,
      // Require confirmation dialog before deleting a home
      "requireConfirmationForDelete": true,
      // Block /home if the destination is unsafe (lava, void, solid ceiling, etc.)
      "enableHomeTeleportSafety": true,
      // Log home set / delete / teleport actions
      "logHomeActions": true
    },

    "warpSettings": {
      // Allow players to create their own warps (requires permission)
      "allowPlayerWarps": true,
      // Maximum player-created warps (-1 = unlimited)
      "maxPlayerWarps": 3,
      // Cooldown in seconds between /warp uses (0 = disabled)
      "warpCooldown": 10,
      // Cooldown in seconds between /setwarp uses (0 = disabled)
      "warpSetCooldown": 60,
      // Allow warps across dimensions
      "allowCrossDimensionWarps": true,
      // Block warps to unsafe locations
      "enableWarpSafety": true,
      // Log warp creation / deletion / usage
      "logWarpActions": true,
      // Require 'neoessentials.warps.<name>' permission for each individual warp
      "perWarpPermission": false
    },

    "spawnSettings": {
      // Teleport players to spawn on their first join
      "spawnOnJoin": true,
      // Teleport players to spawn on death (overrides bed spawn)
      "spawnOnDeath": false,
      // Cooldown in seconds between /spawn uses (0 = disabled)
      "spawnCooldown": 5,
      // Allow /setspawn
      "allowSpawnSet": true,
      // Block spawn teleport if the spawn location is unsafe
      "enableSpawnSafety": true,
      // Log spawn teleports and spawn point changes
      "logSpawnActions": true
    },

    "teleportRequestSettings": {
      // Seconds before TPA requests expire
      "requestTimeout": 60,
      // Maximum pending requests a player can have at once
      "maxPendingRequests": 5,
      // Cooldown in seconds between sending TPA requests
      "cooldownBetweenRequests": 10,
      // Allow multiple TPA requests to the same player
      "allowMultipleRequests": false,
      // Send chat notifications for incoming TPA requests
      "enableRequestNotifications": true,
      // Auto-accept requests from friends (requires friends system)
      "autoAcceptFromFriends": false,
      // Block teleportation to unsafe destinations
      "enableTeleportSafety": true,
      // Log TPA request actions
      "logTeleportRequests": true
    },

    "generalSettings": {
      // Warm-up delay in seconds before teleportation completes (0 = instant)
      "teleportDelay": 3,
      // Cancel the teleport if the player moves during the warm-up delay
      "cancelOnMovement": true,
      // Cancel the teleport if the player takes damage during the warm-up delay
      "cancelOnDamage": false,
      // Show countdown messages during the teleport delay
      "enableTeleportWarmup": true,
      // Allow teleportation while in combat (requires combat system)
      "allowTeleportInCombat": false,
      // Maximum teleport distance in blocks (-1 = unlimited)
      "maxTeleportDistance": -1,
      // Show particle effects at source / destination
      "enableParticleEffects": true,
      // Play sound effects during teleportation
      "enableSoundEffects": true,
      // World regions where teleportation is blocked (requires a region plugin)
      "protectedAreas": []
    },

    /* Random teleport — /tpr  (EssentialsX RandomTeleport port) */
    "randomTeleportSettings": {
      // Default named location slot when /tpr is run with no argument.
      // {world} is replaced with the player's current world name.
      "defaultLocation": "{world}",
      // Global minimum distance from centre in blocks
      "defaultMinRange": 0,
      // Global maximum distance from centre (-1 = half the world border). Every attempt that
      // lands outside already-generated terrain forces a real (potentially costly) chunk
      // generation on the main thread — a smaller range means repeated /tpr uses are more
      // likely to reuse terrain generated by earlier ones, instead of constantly pushing into
      // brand-new territory. Raise this once the surrounding area is mostly pre-generated.
      "defaultMaxRange": 5000,
      // Attempts to find a safe random position before giving up. Each attempt that lands on
      // ungenerated terrain force-generates a chunk — keep this modest on servers without
      // pre-generated terrain, since 10 failed attempts in a row means 10 forced generations.
      "findAttempts": 6,
      // Minimum pre-computed cached locations to maintain
      "cacheThreshold": 5,
      // How many NEW cache slots one /tpr use is allowed to force-generate in the background
      // right after teleporting. Keeping this small (rather than bursting the full gap up to
      // cacheThreshold at once) spreads that cost across several /tpr uses instead of stacking
      // a second lag spike immediately after every teleport.
      "prewarmBatchSize": 2,
      // Cooldown in seconds between /tpr uses per player (0 = disabled)
      "cooldown": 60,
      // "command" (default) = /tpr instantly teleports, exactly as before.
      // "gui" = bare /tpr (no location argument) opens a chest-GUI biome picker instead —
      // /tpr <locationName> still bypasses the GUI either way.
      "mode": "command",
      // Search radius/step (in blocks) used only by GUI biome-picker teleports — same engine
      // /locate biome uses. Larger radius finds rarer biomes but is slower.
      "biomeSearchRadius": 6400,
      "biomeSearchStep": 32,
      // GUI-only: pin specific biomes to fixed slots and/or override their icon.
      //   slot — 0-44, page-1 slot to pin this biome to (0 = top-left box). Optional — omit to
      //          leave the biome auto-positioned (alphabetical, like every other biome) while
      //          still overriding just its icon.
      //   item — icon item id override. Optional — omit to keep the built-in default icon
      //          (that biome's sapling/dedicated block, or a generic fallback if unmapped).
      // Pinned biomes are removed from the auto-listed pool (shown once, at their pinned slot);
      // every unpinned biome — including any this mod doesn't recognize, e.g. from a biome mod —
      // still fills the remaining slots automatically across page 1 and beyond.
      "biomeMenuItems": [
        // { "slot": 0, "biome": "minecraft:taiga", "item": "minecraft:spruce_sapling" }
      ],
      // Biome resource locations excluded globally (e.g. "minecraft:ocean")
      "excludedBiomes": [],
      // Named location slots. Update centre in-game with /settpr <name>.
      "locations": {
        "default": {
          "center": { "x": 0, "y": 64, "z": 0, "world": "minecraft:overworld" },
          "minRange": 0,
          "maxRange": 10000,
          "excludedBiomes": [
            "minecraft:ocean", "minecraft:deep_ocean", "minecraft:frozen_ocean",
            "minecraft:deep_frozen_ocean", "minecraft:cold_ocean", "minecraft:deep_cold_ocean",
            "minecraft:lukewarm_ocean", "minecraft:deep_lukewarm_ocean", "minecraft:warm_ocean",
            "minecraft:the_void"
          ]
        }
      }
    },

    /* /back — return to death location or previous teleport origin */
    "backSettings": {
      // Save death location so /back returns the player to where they died
      "enableDeathBack": true,
      // Save pre-teleport location for /back (home / warp / spawn / tpa)
      "enableTeleportBack": true,
      // Check destination safety before /back teleport
      "enableBackSafety": true,
      // Warm-up delay for /back in seconds (0 = instant, overrides generalSettings.teleportDelay)
      "teleportDelay": 3,
      // Cooldown between /back uses in seconds (0 = disabled)
      "backCooldown": 0
    }
  },

  /* ----------------------------------------------------------------
     Moderation  —  bans, jails, vanish, freeze, kicks
  ---------------------------------------------------------------- */
  "moderation": {

    "banSettings": {
      "enablePermanentBans": true,
      "enableTempBans": true,
      "enableIPBans": true,
      "maxBanReason": 500,
      "defaultBanReason": "Banned by an operator",
      "autoExpireTempBans": true,
      // Interval in seconds to check for expired temp bans (300 = 5 min, 0 = disabled, min 5)
      "checkExpiredBansInterval": 300,
      // Log all ban / unban actions
      "logBanActions": true,
      // Broadcast ban actions to online staff
      "broadcastBans": false,
      "banMessageFormat": "You have been banned from this server.\nReason: {reason}\nBanned by: {bannedBy}\n{duration}",
      "tempBanMessageFormat": "You have been temporarily banned from this server.\nReason: {reason}\nBanned by: {bannedBy}\nExpires: {expiry}",
      "ipBanMessageFormat": "Your IP address has been banned from this server.\nReason: {reason}\nBanned by: {bannedBy}"
    },

    "jailSettings": {
      "enableJailSystem": true,
      // Require a jail location to be set before jailing players
      "requireJailLocation": true,
      // Teleport jailed players back to jail when they reconnect
      "jailTeleportOnLogin": true,
      "maxJailReason": 500,
      "defaultJailReason": "Jailed by an operator",
      "jailMessageFormat": "You have been jailed.\nReason: {reason}\nJailed by: {jailedBy}\nJail: {jail}",
      // Prevent jailed players from using teleportation commands
      "preventJailEscape": true,
      // Log all jail / unjail actions
      "logJailActions": true,
      // Item used as the jail-region selection wand (/jailwand) — right-click sets corner 1,
      // left-click sets corner 2. Any valid item id works.
      "wandItem": "minecraft:stick",
      // Default radius (blocks) for sphere-shaped jails when no explicit radius is given
      "defaultSphereRadius": 10.0,
      // Repeat-offender auto-escalation: jailing the same player this many times (tracked
      // per-player, resets after a perm-ban fires) automatically issues a ban instead of the
      // Nth jail. maxJailsBeforePermBan must stay HIGHER than maxJailsBeforeTempBan, or the
      // temp-ban tier never triggers (the perm-ban check runs first). The admin who triggered
      // the auto-ban gets a direct in-game notice when this fires, in addition to the log line.
      "maxJailsBeforeTempBan": 3,
      "maxJailsBeforePermBan": 6,
      // Duration (minutes) of the automatic temp-ban issued at the maxJailsBeforeTempBan
      // threshold. Default 1440 = 24 hours.
      "tempBanDurationMinutes": 1440
    },

    "vanishSettings": {
      "enableVanishSystem": true,
      // Auto-vanish staff members when they join
      "vanishOnJoin": false,
      // Hide vanished players from the tab list
      "hideFromTabList": true,
      // Prevent vanished players from interacting with non-staff
      "preventInteraction": true,
      // Broadcast vanish toggles to online staff
      "broadcastToStaffVanish": false,
      // Broadcast vanish actions to all players (fake join / quit message)
      "BroadcastToAllVanish": false,
      // Log vanish toggle actions
      "logVanishActions": true
    },

    "freezeSettings": {
      "enableFreezeSystem": true,
      // Prevent frozen players from using commands (except those listed in allowedCommands)
      "preventCommands": true,
      // Commands frozen players are still allowed to use
      "allowedCommands": ["help", "rules", "appeal"],
      // Keep players frozen when they reconnect
      "freezeOnLogin": true,
      "maxFreezeReason": 500,
      "defaultFreezeReason": "Frozen by an operator",
      "freezeMessage": "You have been frozen by {freezer}.\nReason: {reason}\nYou cannot move or interact until unfrozen.",
      "unfreezeMessage": "You have been unfrozen by {unfreezer}",
      "freezeReminder": "You are currently frozen. Contact staff if you need assistance.",
      // Interval in seconds to remind frozen players (0 = disabled)
      "freezeReminderInterval": 30,
      // Log all freeze / unfreeze actions
      "logFreezeActions": true
    },

    "kickSettings": {
      "enableKickSystem": true,
      "maxKickReason": 500,
      "defaultKickReason": "Kicked by an operator",
      // Broadcast kick actions to online staff
      "broadcastKicks": false,
      "kickMessage": "You have been kicked from the server.\nReason: {reason}\nKicked by: {kicker}",
      "kickAllMessage": "Server maintenance in progress. Please reconnect in a few minutes.",
      // Notify online staff when a player is kicked
      "notifyStaffOnKick": true,
      // Log all kick actions
      "logKickActions": true
    },

    "generalSettings": {
      // Permission required to receive staff moderation notifications
      "staffNotificationPermission": "neoessentials.moderation.notify"
    }
  },

  /* ----------------------------------------------------------------
     Chat  —  formatting, filters, channels, private messaging
  ---------------------------------------------------------------- */
  "chat": {

    /* Chat format template.
     * Use a single string for a global format, or an object for per-group/world formats.
     * Object keys: "default", "group:GROUPNAME", "world:WORLDNAME", "group:G:world:W"
     * Placeholders: {neoessentials_displayname}, {neoessentials_username}, {MESSAGE},
     *   {neoessentials_prefix}, {neoessentials_suffix}, {neoessentials_world},
     *   {neoessentials_x/y/z}, {neoessentials_health}, {neoessentials_level}, and more via PAPI.
     * Use '&' for color codes  (e.g. &c = red, &6 = gold).
     */
    "chat-format": {
      "default": "<{neoessentials_prefix} {neoessentials_displayname} {neoessentials_suffix}> {MESSAGE}",
      "group:admin": "&c[Admin] {neoessentials_displayname}: {MESSAGE}",
      "group:mod": "&2[Mod] {neoessentials_displayname}: {MESSAGE}",
      "world:creative": "&b[C] {neoessentials_displayname}: {MESSAGE}"
    },

    // Enable Phase 2 enhancements: clickable names, mentions, URL linking, [item] display
    "enableChatEnhancements": true,
    // Make player names in chat clickable (hover for stats, click to message)
    "clickablePlayerNames": true,
    // Append a small clickable link icon after clickable player names in chat that opens
    // their public dashboard profile (/lookup?player=<name>) in a browser. Requires
    // clickablePlayerNames above AND a resolvable dashboard URL — webDashboard.externalDashboard.url
    // (set via /dashboard pair) in "external" mode, or webDashboard.publicUrl in "internal" mode.
    // Silently has no effect if neither URL is configured.
    "showProfileLinkInChat": true,
    // Automatically linkify URLs in chat
    "autoLinkUrls": true,
    // Allow [item] placeholder to show the held item in chat
    "allowItemLinks": true,

    "mentions": {
      // Enable @PlayerName mention system
      "enabled": true,
      // Color code applied to highlighted @mentions (e.g. &e = yellow)
      "highlightColor": "&e",
      // Play a sound when a player is mentioned
      "playSound": true,
      // Sound name: entity.experience_orb.pickup, block.note_block.pling, etc.
      "soundName": "entity.experience_orb.pickup",
      "soundVolume": 1.0,
      // Require 'neoessentials.chat.mention' permission to use @mentions
      "requirePermission": false,
      "permission": "neoessentials.chat.mention"
    },

    "badges": {
      // Enable rank badges and status icons in chat
      "enabled": true,
      // Badge position: 'before_prefix' | 'after_prefix' | 'before_name' | 'after_name'
      "badgePosition": "before_prefix",
      // NOT FULLY IMPLEMENTED YET — see docs/Wiki/ChatSystem.md#custom-png-badge-images-current-limitations.
      // Generates a resource pack from config/neoessentials/badges/<rank>.png files, but (a) the
      // pack is never actually pushed to players (autoSendResourcePack below doesn't send anything
      // despite the name — you'd have to host it yourself and set server.properties manually) and
      // (b) even then, chat always shows the rankBadges emoji below, never the custom image. Leave
      // this false and use rankBadges (emoji/text) instead — that part fully works today.
      "useCustomImages": false,
      // Badge image size in pixels (16, 24, or 32) — only relevant once useCustomImages actually renders in chat
      "customImageSize": 16,
      // Path to badge images folder relative to server root
      "customImagePath": "config/neoessentials/badges",
      // Does NOT auto-send anything yet — only generates the pack + logs manual server.properties
      // setup instructions on join. See the useCustomImages note above.
      "autoSendResourcePack": false,
      // Reserved for when auto-send is implemented — currently unused
      "requireResourcePack": false,
      // Public URL where the resource pack is hosted, for the manual server.properties setup above.
      "resourcePackUrl": "",
      // Reserved for when auto-send is implemented — currently unused
      "resourcePackPrompt": "This server uses custom badge images. Please accept the resource pack for the best experience!",
      // Emoji/text badge shown per rank (looked up by primary group, lowercased) — this is the
      // part that actually works. A group with no entry, or an empty string, gets no badge.
      "rankBadges": {
        "owner": "",
        "admin": "⭐",
        "moderator": "️",
        "helper": "",
        "vip": "",
        "vipplus": "",
        "mvp": "",
        "builder": "",
        "developer": ""
      },
      "statusIcons": {
        // Show status icons (AFK, vanished, etc.) in chat
        "enabled": true,
        // Position: 'before_name' | 'after_name' | 'after_message'
        "iconPosition": "after_name",
        "afk": "",
        "vanished": "",
        "streaming": "",
        "muted": ""
      }
    },

    "antiSpam": {
      // Master switch for the anti-spam filter
      "enabled": true,

      "capsFilter": {
        // Filter messages with excessive CAPS (shouting)
        "enabled": true,
        // Maximum percentage of uppercase letters allowed (1–100)
        "maxPercentage": 70,
        // Action: 'lowercase' | 'block' | 'warn'
        "action": "lowercase",
        "bypassPermission": "neoessentials.chat.caps.bypass",
        // Minimum message length to check (avoids flagging short messages like "OK")
        "minimumLength": 5
      },

      "repeatFilter": {
        // Prevent sending identical messages in quick succession
        "enabled": true,
        // Seconds before the same message can be sent again
        "cooldownSeconds": 5,
        // Action: 'block' | 'warn'
        "action": "block",
        "bypassPermission": "neoessentials.chat.repeat.bypass"
      },

      "linkFilter": {
        // Filter URLs in chat
        "enabled": false,
        // Action: 'allow' (all) | 'block' (all) | 'whitelist' (only listed domains)
        "action": "allow",
        "whitelist": ["minecraft.net", "neoforged.net", "github.com"],
        "bypassPermission": "neoessentials.chat.links.bypass"
      },

      "spamFilter": {
        // Rate-limit chat to prevent message flooding
        "enabled": true,
        // Maximum messages per period before blocking
        "messagesPerPeriod": 5,
        // Period length in seconds
        "periodSeconds": 10,
        // Action: 'block' | 'warn'
        "action": "block",
        "bypassPermission": "neoessentials.chat.spam.bypass"
      }
    },

    "formatTemplates": {
      // When true, use 'activeTemplate' instead of 'chat-format'
      "enabled": false,
      // Active template: 'default' | 'rpg' | 'modern' | 'minimal' | 'detailed' | 'ranked' | 'custom'
      "activeTemplate": "default",
      "templates": {
        "default": "<{neoessentials_prefix} {neoessentials_displayname} {neoessentials_suffix}> {MESSAGE}",
        "rpg": "&7[Lv.{neoessentials_level}] {neoessentials_prefix}{neoessentials_displayname}&r: {MESSAGE}",
        "modern": "● {neoessentials_prefix}{neoessentials_displayname} &8› &r{MESSAGE}",
        "minimal": "{neoessentials_displayname}: {MESSAGE}",
        "detailed": "&7[{neoessentials_world}] &r<{neoessentials_prefix}{neoessentials_displayname}{neoessentials_suffix}&r> {MESSAGE}",
        "ranked": "&7[{neoessentials_group}] {neoessentials_prefix}{neoessentials_displayname}&r: {MESSAGE}",
        "custom": "<{neoessentials_prefix} {neoessentials_displayname} {neoessentials_suffix}> {MESSAGE}"
      }
    },

    "richText": {
      // Enable Phase 4 rich-text effects (gradients, rainbow). Can be performance-intensive.
      "enabled": false,
      // Allow <gradient:FF0000-0000FF>text</gradient> syntax
      "allowGradients": true,
      // Allow <rainbow>text</rainbow> syntax
      "allowRainbow": true
    },

    "conditionalFormatting": {
      // Enable Phase 4 conditional formatting (time / stat / state-based dynamic formats)
      "enabled": false,
      // Allow <if:time=morning>…</if>  (morning/afternoon/evening/night/day/weekday/weekend)
      "allowTimeConditionals": true,
      // Allow <if:health<50>…</if>  (health/level/food/armor/xp with <, >, =, !=)
      "allowStatConditionals": true,
      // Allow <if:afk>…</if>  (afk/vanished/flying/creative/survival/spectator/op/…)
      "allowStateConditionals": true
    },

    /* Chat channels.
     * Set "enabled" to false to disable all channels and use plain global chat.
     * Per-channel flags: enabled, command, aliases, prefix, default, discord bridge, displayName.
     * For proximity-only servers: keep local.enabled=true, global.enabled=false.
     * For global-only servers: set channels.enabled=false OR local.enabled=false.
     *
     * The key you give a channel here (e.g. "local", "staff") MUST stay a plain, simple string —
     * it's the internal identifier used for prefix routing, the discord.channelId lookup, and —
     * when "command" isn't set — the actual slash-command literal players type. Don't put color
     * codes/emoji/special characters in the KEY itself; a broken command literal there can abort
     * registration for every channel listed after it in this file.
     *
     * Want a styled/colored channel name instead? Use the optional "displayName" field — it's
     * shown wherever the {channel}/{neoessentials_channel} chat placeholder is used (see
     * chat-format above), completely independent of the safe internal key. E.g.:
     *   "staff": { ..., "displayName": "&d⚙ Staff" }
     * then use {channel} in chat-format: "&8[{channel}&8]&r {neoessentials_username}: {MESSAGE}"
     *
     * Want a channel that only reaches your FTB Teams (or similar) teammates? Set
     * "teamBased": true instead of "radius"/"permission" — see the "team" example below.
     * Requires FTB Teams (or another supported team mod) to be installed; without one, the
     * channel just tells players it isn't available.
     */
    "channels": {
      "enabled": true,
      "team": {
        "enabled": true,
        "command": "team",
        "aliases": ["t", "teamchat"],
        "displayName": "&a⛨ Team",
        "teamBased": true,
        "default": false,
        "discord": {
          "enabled": false,
          "channelId": "",
          // No-bot-required alternative to channelId — a Discord webhook URL (Discord:
          // Server Settings > Integrations > Webhooks). If both are set, both fire.
          "webhookUrl": ""
        }
      },
      "local": {
        "enabled": true,
        "radius": 100,
        "command": "l",
        "aliases": ["local", "lc"],
        "prefix": "",
        "default": true,
        "discord": {
          // Usually disabled: local chat is proximity-based, discord bridge is global
          "enabled": false,
          // Discord channel ID. Leave empty to use the default 'chat' channel.
          "channelId": "",
          "webhookUrl": ""
        }
      },
      "global": {
        "enabled": true,
        "command": "g",
        // "gc" was previously listed here too, but it collides with the built-in memory/TPS
        // diagnostics command (/gc) — that command wins the registration, so the alias was
        // silently unusable for switching channels. Use /g or /global instead.
        "aliases": ["global"],
        "prefix": "!",
        "default": false,
        "discord": {
          "enabled": true,
          "channelId": "",
          "webhookUrl": ""
        }
      },
      "staff": {
        "enabled": true,
        "command": "staff",
        "aliases": ["mod", "admin", "s"],
        "prefix": "@",
        "permission": "neoessentials.chat.staff",
        "default": false,
        "discord": {
          "enabled": true,
          // Use a private staff-only Discord channel here (recommended)
          "channelId": "",
          "webhookUrl": ""
        }
      }
    },

    "enable-chat-formatting": true,
    "enable-color-codes": true,
    // Log all chat messages to console/log. false = suppress chat from console entirely.
    "logChatToConsole": true,
    // Commands blocked when a player is muted
    "muteCommands": [],

    /* Private-message and SocialSpy format overrides.
     * Leave blank ("") to use the default from the language file (en_us.json).
     * Placeholders: {sender}, {receiver}, {message}, {sender_displayname}, {receiver_displayname}
     * Also supports {neoessentials_*} PlaceholderAPI tokens and & color codes.
     */
    "messaging": {
      // SocialSpy broadcast format. Default: "&8[&eSocialSpy&8] &b{sender} &7→ &b{receiver}&7: &f{message}"
      "socialspyFormat": "",
      // /msg sender format. Default: "&7[&aTo &f{neoessentials_displayname}&7] &f{message}"
      "msgFormatTo": "",
      // /msg receiver format. Default: "&7[&bFrom &f{neoessentials_displayname}&7] &f{message}"
      "msgFormatFrom": "",
      // /reply sender format (blank = use msgFormatTo default)
      "replyFormatTo": "",
      // /reply receiver format (blank = use msgFormatFrom default)
      "replyFormatFrom": ""
    },

    "playerChatPermissions": [],

    /* Custom join / quit messages.
     * Use "none" for the built-in default message.
     * Placeholders: {neoessentials_displayname}, {neoessentials_username},
     *   {neoessentials_prefix}, {neoessentials_suffix}, {neoessentials_world},
     *   and more via PlaceholderAPI. Use '&' for colors.
     * Example: "&a{neoessentials_prefix}&f{neoessentials_displayname} &ejoined the server!"
     */
    "customJoinMessage": "none",
    "customQuitMessage": "none"
  },

  /* ----------------------------------------------------------------
     Discord embed template — customizes the rich embed built for chat
     messages routed to a specific chat.channels.<name>.discord.channelId
     (currently only the Simple Discord Link integration builds a real
     embed; other bridge mods still send a plain text line). Only used
     when a channel actually has a channelId configured — see chat.channels.
  ---------------------------------------------------------------- */
  "discordEmbedTemplate": {
    // Master switch. false = fall back to a plain "PlayerName: message" line.
    "enabled": true,
    // Placeholders available in every field below:
    //   {player}  - the sender's username
    //   {uuid}    - the sender's UUID (for building an avatar URL yourself)
    //   {message} - the chat message content
    //   {channel} - the NeoEssentials chat channel name (e.g. "global")
    "authorName": "{player}",
    "authorIconUrl": "https://mc-heads.net/avatar/{uuid}",
    "description": "{message}",
    // Hex color for the embed's side bar, e.g. "#5865F2" (Discord blurple). Leave empty ("")
    // for Discord's default embed color.
    "color": "#5865F2",
    // Optional footer text/icon. Leave both empty to omit the footer entirely.
    "footerText": "",
    "footerIconUrl": "",
    // Show the current time as the embed's timestamp
    "showTimestamp": false
  },

  /* ----------------------------------------------------------------
     Per-event-type Discord channel routing. Chat already has this per
     chat-channel (see chat.channels.<name>.discord.channelId above) — this
     covers everything that ISN'T a chat message, since those events aren't
     tied to any one NeoEssentials chat channel. Leave a channelId empty (or
     enabled:false) to let whichever bridge mod (SDLink/Mc2Discord/
     DCIntegration) route that event to its own natively-configured default
     channel instead — this only overrides where NeoEssentials explicitly
     routes an event when a channelId is actually set. webhookUrl is the
     no-bot-required alternative (a Discord webhook URL) — set either or
     both; if both are set for the same event, both fire independently.
  ---------------------------------------------------------------- */
  "discordEventChannels": {
    "join":        { "enabled": false, "channelId": "", "webhookUrl": "" },
    "leave":       { "enabled": false, "channelId": "", "webhookUrl": "" },
    "mute":        { "enabled": false, "channelId": "", "webhookUrl": "" },
    "afk":         { "enabled": false, "channelId": "", "webhookUrl": "" },
    "advancement": { "enabled": false, "channelId": "", "webhookUrl": "" },
    "privateMessage": { "enabled": false, "channelId": "", "webhookUrl": "" }
  }
}