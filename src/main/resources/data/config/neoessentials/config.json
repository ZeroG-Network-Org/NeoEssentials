{
  // DO NOT MODIFY: Used by NeoEssentials for automatic config updates.
  // Changing this may cause config corruption.
  "_configVersion": 49,

  /* ================================================================
     NeoEssentials — Main Configuration  (config.json)
     Reload in-game: /neoessentials reload
  ================================================================ */

  // Plain, single-line server name — used by the {server_name} placeholder (scoreboard,
  // tablist, chat, etc). Deliberately separate from server.properties' "motd" (and from
  // NeoEssentials' own /motd system): that MOTD is typically multi-line and heavily
  // formatted for the multiplayer server list, which breaks when dropped into a single
  // scoreboard/tablist line. Use {server_motd} instead if you actually want the configured
  // MOTD text somewhere.
  "general": {
    "serverName": "My Server"
  },

  // How often the hologram scheduler POLLS every hologram to see if it's due for a refresh
  // (pollIntervalTicks, in server ticks — 20 = once/second) and advances animation/spin/hover
  // (animationInterval, in ticks — 1 = every tick, the fastest possible). pollIntervalTicks is
  // NOT how often placeholders actually refresh — that's each hologram's own refreshInterval
  // (in SECONDS, default 5, set via "/hologram refreshinterval <id> <seconds>"). Lowering
  // pollIntervalTicks below that per-hologram gate does nothing visible; it only exists so the
  // gate itself gets checked promptly rather than up to a full poll cycle late. animationInterval
  // only covers {animation:NAME} frame advancement, /hologram addframes cycling, and spin/hover
  // motion — there's no benefit setting it below 1, since an animation's own frameDuration is
  // already clamped to a 50ms (1-tick) minimum. Apply changes with "/neoe reload".
  "hologram": {
    "pollIntervalTicks": 10,
    "animationInterval": 1
  },

  // Enable or disable major mod subsystems (true = enabled, false = disabled).
  // RESTART REQUIRED — whether a command is registered at all (and whether a subsystem's
  // manager is initialized) is decided once at server start. "/neoe reload" only refreshes
  // config VALUES, it can't add/remove already-registered commands, so toggling anything in
  // this section (or in "commands" below) will NOT take effect until the server restarts.
  "modules": {
    "economyEnabled": true,
    "permissionsEnabled": true,
    "kitsEnabled": true,
    "teleportationEnabled": true,
    "moderationEnabled": true,
    "chatEnabled": true,
    "webDashboardEnabled": true,
    "hologramsEnabled": true,
    "shopEnabled": true,
    "auctionHouseEnabled": true,
    "vaultEnabled": true,
    "tablistEnabled": true,
    "scoreboardEnabled": true,
    "resourcePacksEnabled": true,
    "playerTagsEnabled": true,
    "discordIntegrationEnabled": true,
    "votifierEnabled": true,
    "cratesEnabled": true
  },

  // Per-subsystem logging control. For each category:
  //   "normal": routine info-level messages -> console + logs/latest.log (default: on)
  //   "debug":  verbose trace messages      -> logs/debug.log only       (default: off)
  // Warnings and errors are ALWAYS logged regardless of these settings — these toggles
  // only control routine chatter and opt-in verbose tracing, never real problems.
  // Reload in-game with /neoessentials reload after changing these.
  "logging": {
    "categories": {
      "chat":          { "normal": true, "debug": false },
      "economy":       { "normal": true, "debug": false },
      "permissions":   { "normal": true, "debug": false },
      "teleportation": { "normal": true, "debug": false },
      "moderation":    { "normal": true, "debug": false },
      "auctionHouse":  { "normal": true, "debug": false },
      "kits":          { "normal": true, "debug": false },
      "webDashboard":  { "normal": true, "debug": false },
      "discord":       { "normal": true, "debug": false },
      "config":        { "normal": true, "debug": false },
      "commands":      { "normal": true, "debug": false },
      "votifier":      { "normal": true, "debug": false },
      "crates":        { "normal": true, "debug": false },
      "general":       { "normal": true, "debug": false }
    }
  },

  /* ----------------------------------------------------------------
     Storage  —  where per-manager data (bans, mutes, kicks, warns,
     notes, reports, and future managers migrated onto this system)
     is actually persisted. Restart required after changing "type".
  ---------------------------------------------------------------- */
  "storage": {
    // "json" (default, one file per collection), "yaml" (same shape, human-editable),
    // "sqlite" (single embedded database file), or "mysql" (shared network database —
    // use this to sync moderation/economy/etc. data across multiple servers).
    // RESTART REQUIRED — StorageManager picks the backend once at server start and never
    // reconstructs it; "/neoe reload" only refreshes config VALUES, so changing this and
    // reloading silently keeps every manager on the OLD backend with no warning that
    // anything is wrong. Existing data auto-migrates into the new backend on the restart
    // that actually picks it up (see autoMigrate below).
    "type": "json",
    // Existing JSON data is imported automatically the first time you switch away
    // from "json" — set false only if you deliberately want a fresh, empty store.
    "autoMigrate": true,
    "sqlite": {
      // Relative to the server's data directory (neoessentials/store/<this file>)
      "file": "data.db",
      // The SQLite driver isn't bundled in the mod jar (it used to be, but its native library
      // caused it to conflict with other mods that also bundle their own copy — see the
      // SqliteDriverProvisioner javadoc). It's downloaded from Maven Central and verified
      // against a pinned checksum the first time SQLite storage is actually used. Set false to
      // disable that download and place the driver jar yourself instead — the server log will
      // tell you the exact path and download URL if it's missing.
      "autoDownloadDriver": true
    },
    "mysql": {
      "host": "localhost",
      "port": 3306,
      "database": "neoessentials",
      "username": "neoessentials",
      "password": "",
      "useSSL": false,
      // Max concurrent connections in the pool
      "poolSize": 10,
      // The MySQL driver isn't bundled in the mod jar (it used to be, but it caused the same
      // kind of split-package module conflict as the SQLite driver used to — see the
      // MySqlDriverProvisioner javadoc). It's downloaded from Maven Central and verified
      // against a pinned checksum the first time MySQL storage is actually used. Set false to
      // disable that download and place the driver jar yourself instead — the server log will
      // tell you the exact path and download URL if it's missing.
      "autoDownloadDriver": true
    }
  },

